# Database
DATABASE_URL="postgresql://username:password@localhost:5432/kurye_sistemi?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:3000,https://your-frontend.vercel.app"

# Demo seed (default: enabled; set false to disable)
SEED_DEMO_USERS="true"

# Optional AI OCR (AI first, fallback to local OCR)
# For OpenRouter free tier example, set these values:
# AI_OCR_API_URL="https://openrouter.ai/api/v1/chat/completions"
# AI_OCR_API_KEY="your-openrouter-api-key"
# AI_OCR_MODEL="google/gemini-2.0-flash-exp:free"
AI_OCR_TIMEOUT_MS="25000"

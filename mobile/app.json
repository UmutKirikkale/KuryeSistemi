{
  "expo": {
    "name": "Kurye Sistemi",
    "slug": "kurye-sistemi-mobile",
    "version": "1.0.0",
    "scheme": "kuryesistemi",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/7ceff21e-71f8-4a0d-8002-3b56e0891d62",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.umutkirikkale.kuryesistemi",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Kurye konum takibi ve harita ozellikleri icin konum izni gerekir.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Kurye teslimat sirasinda arka planda konum takibi icin izin gerekir.",
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.umutkirikkale.kuryesistemi",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#63B8E6"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#63B8E6"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kurye konum takibi ve harita ozellikleri icin konum izni gerekir.",
          "locationAlwaysAndWhenInUsePermission": "Kurye teslimat sirasinda arka planda konum takibi icin izin gerekir.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Siparis fotografini secip OCR ile analiz etmek icin galeri izni gerekir."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7ceff21e-71f8-4a0d-8002-3b56e0891d62"
      }
    }
  }
}
